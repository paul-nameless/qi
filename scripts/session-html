#!/usr/bin/env python3
"""Render a qi session as an HTML timeline and open it in the browser.

usage: session-html [ID-prefix | path.jsonl] [-o out.html] [--no-open]
Without an argument it takes the newest session of the current directory.
"""
import argparse
import difflib
import glob
import html
import json
import os
import re
import subprocess
import sys
from collections import defaultdict
from datetime import datetime

MAX_RESULT = 200_000
INLINE_CODE = re.compile(r"`([^`\n]+)`")


def sessions_root():
    if os.environ.get("QI_SESSION_DIR"):
        return os.environ["QI_SESSION_DIR"]
    data = os.environ.get("XDG_DATA_HOME")
    if not data or not os.path.isabs(data):
        data = os.path.expanduser("~/.local/share")
    return os.path.join(data, "qi", "sessions")


def cwd_dir(cwd):
    name = cwd.replace("/", "-").replace("\\", "-").replace(":", "").replace(".", "-")
    return os.path.join(sessions_root(), name)


def resolve(arg):
    if arg and os.path.isfile(arg):
        return arg
    if not arg:
        files = glob.glob(os.path.join(glob.escape(cwd_dir(os.getcwd())), "*.jsonl"))
        if not files:
            sys.exit("no sessions for " + os.getcwd())
        return max(files, key=os.path.getmtime)
    root = glob.escape(sessions_root())
    hits = glob.glob(os.path.join(root, "*", arg + "*.jsonl")) + glob.glob(os.path.join(root, "*", "subagents", arg + "*.jsonl"))
    hits = sorted(set(hits))
    if not hits:
        sys.exit("no session matches " + arg)
    if len(hits) > 1:
        sys.exit("ambiguous id:\n  " + "\n  ".join(hits))
    return hits[0]


def ts(s):
    return datetime.strptime(s, "%Y-%m-%dT%H:%M:%SZ").timestamp() if s else 0


def load(path):
    with open(path) as f:
        return [json.loads(l) for l in f if l.strip()]


def first_user_text(entries):
    for e in entries:
        m = e.get("message")
        if m and m["role"] == "user":
            return "".join(b.get("text", "") for b in m["blocks"] if b["type"] == "text")
    return None


def find_subagent(sub_dir, parent_id, prompt, start, end, used):
    for p in sorted(glob.glob(os.path.join(glob.escape(sub_dir), "*.jsonl"))):
        if p in used:
            continue
        try:
            entries = load(p)
        except (OSError, ValueError):
            continue
        if not entries or not start - 5 <= ts(entries[0].get("time")) <= end + 5:
            continue
        parent = entries[0].get("parent_session")
        if parent and parent != parent_id:
            continue
        if first_user_text(entries) == prompt:
            used.add(p)
            return p, entries
    return None, None


def reasoning_text(raw):
    if not isinstance(raw, dict):
        return ""
    for k in ("thinking", "text", "content"):
        if isinstance(raw.get(k), str):
            return raw[k]
    parts = raw.get("summary") or raw.get("content") or []
    if isinstance(parts, list):
        return "\n\n".join(p.get("text", "") for p in parts if isinstance(p, dict))
    return ""


def tool_label(name, inp):
    if not isinstance(inp, dict):
        return ""
    for k in ("command", "file_path", "path", "pattern", "query", "url"):
        if isinstance(inp.get(k), str):
            return inp[k]
    if name == "subagent":
        return (inp.get("model", "") + " " + inp.get("effort", "")).strip()
    if name == "mcp_call":
        return f"{inp.get('server', '')}.{inp.get('tool', '')}"
    return json.dumps(inp, ensure_ascii=False)[:200]


class Session:
    """Steps: ('llm', ...), ('tools', ...), ('user', ...), ('compaction', ...), ('drop', ...)."""

    def __init__(self, path, entries, depth=0):
        self.path, self.depth = path, depth
        self.meta = entries[0] if entries and entries[0]["type"] == "meta" else {}
        self.sub_dir = os.path.join(os.path.dirname(path), "subagents") if depth == 0 else os.path.dirname(path)
        self.used = set()
        self.turns = []
        self.build(entries)

    def build(self, entries):
        prev_t = ts(self.meta.get("time"))
        turn = None
        pending = {}
        for e in entries[1:] if self.meta else entries:
            t = ts(e.get("time"))
            m = e.get("message")
            if e["type"] == "compaction":
                step = {"kind": "compaction", "dur": t - prev_t, "summary": e.get("summary", ""), "kept": len(e.get("kept") or []), "model": e.get("model")}
                (turn or self.new_turn(None, t))["steps"].append(step)
            elif e["type"] == "drop":
                (turn or self.new_turn(None, t))["steps"].append({"kind": "drop", "dur": 0})
            elif m and m["role"] == "user" and any(b["type"] == "tool_result" for b in m["blocks"]):
                results = {b.get("tool_use_id"): b for b in m["blocks"] if b["type"] == "tool_result"}
                step = pending.pop("step", None)
                if step:
                    step["dur"] = t - step["start"]
                    for c in step["calls"]:
                        r = results.get(c["id"], {})
                        c["result"] = r.get("text", "")
                        c["error"] = r.get("is_error", False)
                        c["images"] = len(r.get("images") or [])
                        if c["name"] == "subagent":
                            p, sub = find_subagent(self.sub_dir, os.path.basename(self.path)[:-6], c["input"].get("prompt"), step["start"], t, self.used)
                            if sub:
                                c["sub"] = Session(p, sub, self.depth + 1)
                    turn["steps"].append(step)
            elif m and m["role"] == "user":
                text = "\n".join(b.get("text", "") for b in m["blocks"] if b["type"] == "text")
                imgs = sum(1 for b in m["blocks"] if b["type"] == "image")
                turn = self.new_turn(text + (f"\n[{imgs} image(s)]" if imgs else ""), t)
                if self.turns[:-1]:
                    turn["idle"] = t - prev_t
            elif m and m["role"] == "assistant":
                if turn is None:
                    turn = self.new_turn(None, prev_t)
                u = e.get("usage") or {}
                blocks = m["blocks"]
                calls = [{"id": b.get("id"), "name": b.get("name"), "input": b.get("input") or {}} for b in blocks if b["type"] == "tool_use"]
                turn["steps"].append({
                    "kind": "llm", "dur": t - prev_t, "model": e.get("model") or self.meta.get("model"), "usage": u,
                    "text": "\n\n".join(b.get("text", "") for b in blocks if b["type"] == "text"),
                    "reasoning": "\n\n".join(reasoning_text(b.get("raw")) for b in blocks if b["type"] == "reasoning_raw").strip(),
                    "ncalls": len(calls),
                })
                if calls:
                    pending["step"] = {"kind": "tools", "start": t, "dur": 0, "calls": calls}
            prev_t = t
            if turn:
                turn["end"] = t
        if pending.get("step") and turn:
            s = pending["step"]
            for c in s["calls"]:
                c.update(result="(no result recorded: interrupted?)", error=True, images=0)
            turn["steps"].append(s)

    def new_turn(self, prompt, t):
        turn = {"prompt": prompt, "start": t, "end": t, "steps": [], "idle": 0}
        self.turns.append(turn)
        return turn

    def walk(self):
        for turn in self.turns:
            for s in turn["steps"]:
                yield s

    def totals(self):
        tot = defaultdict(float)
        by = defaultdict(lambda: {"n": 0, "time": 0.0, "max": 0.0, "err": 0})
        for s in self.walk():
            if s["kind"] == "llm":
                tot["llm"] += s["dur"]
                tot["calls"] += 1
                for k in ("input", "output", "cache_read", "cache_write"):
                    tot[k] += s["usage"].get(k, 0)
                if not any(s["usage"].values()):
                    tot["no_usage"] += 1
                row = by["model " + (s["model"] or "?")]
                row["n"] += 1
                row["time"] += s["dur"]
                row["max"] = max(row["max"], s["dur"])
            elif s["kind"] == "compaction":
                tot["llm"] += s["dur"]
                row = by["compaction"]
                row["n"] += 1
                row["time"] += s["dur"]
            elif s["kind"] == "tools":
                tot["tools"] += s["dur"]
                share = s["dur"] / len(s["calls"])
                for c in s["calls"]:
                    tot["tool_calls"] += 1
                    row = by[c["name"]]
                    row["n"] += 1
                    row["time"] += share
                    row["max"] = max(row["max"], s["dur"])
                    row["err"] += bool(c.get("error"))
                    tot["errors"] += bool(c.get("error"))
        tot["idle"] = sum(t["idle"] for t in self.turns)
        if self.turns:
            tot["wall"] = self.turns[-1]["end"] - ts(self.meta.get("time") or "") if self.meta else self.turns[-1]["end"] - self.turns[0]["start"]
        return tot, by


def fmt_dur(s):
    s = int(round(s))
    if s < 1:
        return "0s"
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m{s % 60:02d}s"
    return f"{s // 3600}h{s % 3600 // 60:02d}m"


def fmt_n(n):
    n = int(n)
    return f"{n / 1e6:.1f}M" if n >= 1e6 else f"{n / 1e3:.1f}k" if n >= 1e4 else str(n)


def esc(s):
    return html.escape(s or "")


def clip(s):
    if len(s) <= MAX_RESULT:
        return s
    return s[:MAX_RESULT] + f"\n… ({len(s) - MAX_RESULT} more chars)"


def fmt_size(text):
    lines = text.count("\n") + 1 if text else 0
    return f"{lines} lines" if lines > 1 else f"{len(text)} chars"


def local_time(s):
    return datetime.fromtimestamp(ts(s)).strftime("%d %b %Y, %H:%M") if s else ""


KINDS = {"model", "bash", "read", "edit", "write", "subagent", "tool_search", "mcp_call", "compaction", "mixed"}
MAG = 40


def kind_class(name):
    return "k-" + name if name in KINDS else "k-other"


def inline(text):
    return INLINE_CODE.sub(r"<code>\1</code>", esc(text))


def deep_counts(sess):
    calls = errs = 0
    for s in sess.walk():
        if s["kind"] != "tools":
            continue
        for c in s["calls"]:
            calls += 1
            errs += bool(c.get("error"))
            if c.get("sub"):
                n, e = deep_counts(c["sub"])
                calls += n
                errs += e
    return calls, errs


def step_kind(s):
    if s["kind"] == "llm":
        return "model"
    if s["kind"] == "tools":
        names = {c["name"] for c in s["calls"]}
        return names.pop() if len(names) == 1 else "mixed"
    return s["kind"]


class Renderer:
    def __init__(self):
        self.seq = 0

    def anchor(self):
        self.seq += 1
        return f"s{self.seq}"

    def page(self, sess):
        sid = os.path.basename(sess.path)[:-6]
        meta = sess.meta
        _, errs = deep_counts(sess)
        fail = f'<button class="failbtn" onclick="nextFail(this)">{errs} failed</button>' if errs else ""
        prompt = next((t["prompt"] for t in sess.turns if t["prompt"]), "") or "qi session"
        title = prompt.strip().split("\n")[0].rstrip(":")
        bits = [meta.get("cwd"), meta.get("model"), meta.get("kind"), local_time(meta.get("time"))]
        return (
            f'<div class="bar"><div class="barin"><span class="brand">qi session</span><code class="sid">{esc(sid)}</code>'
            f'<span class="grow"></span>{fail}<button onclick="toggleAll(true)">Expand all</button><button onclick="toggleAll(false)">Collapse all</button></div></div>'
            f'<main><h1>{esc(title[:100])}{"…" if len(title) > 100 else ""}</h1>'
            f'<div class="metaline">{"".join(f"<span>{esc(b)}</span>" for b in bits if b)}</div>'
            f'{self.session(sess, top=True)}</main>'
        )

    def stats(self, sess, tot):
        active = tot["llm"] + tot["tools"]
        _, deep_errs = deep_counts(sess)
        nested = int(deep_errs - tot["errors"])
        tools_sub = f"{int(tot['tool_calls'])} calls"
        if tot["errors"]:
            tools_sub += f' · <b class="errc">{int(tot["errors"])} failed</b>'
        if nested:
            tools_sub += f' · <b class="errc">{nested} failed in subagents</b>'
        has_tokens = tot["input"] or tot["output"]
        tok_sub = []
        if tot["cache_read"] or tot["cache_write"]:
            tok_sub.append(f"{fmt_n(tot['cache_read'])} cache read · {fmt_n(tot['cache_write'])} written")
        if tot["no_usage"]:
            tok_sub.append(f"{int(tot['no_usage'])} calls without usage" if has_tokens else "usage not reported")
        cells = [
            ("Wall time", fmt_dur(tot["wall"]), f"{fmt_dur(active)} working" + (f" · {fmt_dur(tot['idle'])} waiting on you" if tot["idle"] >= 1 else "")),
            ("Model", fmt_dur(tot["llm"]), f"{int(tot['calls'])} calls"),
            ("Tools", fmt_dur(tot["tools"]), tools_sub),
            ("Tokens", f"{fmt_n(tot['input'])} in · {fmt_n(tot['output'])} out" if has_tokens else "–", " · ".join(tok_sub)),
        ]
        return '<div class="stats">' + "".join(
            f'<div class="stat"><div class="k">{k}</div><div class="v">{esc(v)}</div><div class="s">{sub}</div></div>' for k, v, sub in cells
        ) + "</div>"

    def breakdown(self, tot, by):
        active = tot["llm"] + tot["tools"]
        rows = sorted(by.items(), key=lambda kv: -kv[1]["time"])
        out = ['<table class="by"><thead><tr><th>Where the time went</th><th class="barc"></th><th>share</th><th>time</th><th>calls</th><th class="opt">avg</th><th class="opt">max</th><th>failed</th></tr></thead><tbody>']
        for name, r in rows:
            if name.startswith("model "):
                key, label = "model", f'model <span class="dim">{esc(name[6:])}</span>'
            else:
                key, label = name, esc(name)
            pct = 100 * r["time"] / active if active else 0
            failed = f'<td class="errc">{r["err"]}</td>' if r["err"] else '<td class="faint">–</td>'
            out.append(
                f'<tr class="{kind_class(key)}"><td><i class="sw"></i>{label}</td><td class="barc"><i style="width:{pct:.1f}%"></i></td>'
                f'<td class="pct">{pct:.0f}%</td><td>{fmt_dur(r["time"])}</td><td>{r["n"]}</td>'
                f'<td class="opt">{fmt_dur(r["time"] / r["n"]) if r["n"] else ""}</td><td class="opt">{fmt_dur(r["max"])}</td>{failed}</tr>'
            )
        out.append("</tbody></table>")
        return "".join(out)

    def waterfall(self, sess, anchors):
        if not sess.turns:
            return ""
        longest = max((sum(s["dur"] for s in t["steps"]) for t in sess.turns), default=0) or 1
        seen = []
        rows = []
        for i, turn in enumerate(sess.turns):
            total = sum(s["dur"] for s in turn["steps"])
            segs = []
            for s in turn["steps"]:
                if s["kind"] == "drop":
                    continue
                key = step_kind(s)
                if key not in seen:
                    seen.append(key)
                tip = f"{key} {fmt_dur(s['dur'])}"
                err = ""
                if s["kind"] == "tools":
                    names = sorted({c["name"] for c in s["calls"]})
                    tip = f"{', '.join(names)} {fmt_dur(s['dur'])}\n" + "\n".join(tool_label(c["name"], c["input"])[:100] for c in s["calls"])
                    err = " segerr" if any(c.get("error") for c in s["calls"]) else ""
                segs.append(f'<a href="#{anchors[id(s)]}" class="seg {kind_class(key)}{err}" style="flex-grow:{max(s["dur"], 0.3):g}" title="{esc(tip)}"></a>')
            label = esc((turn["prompt"] or "(continued)").strip().split("\n")[0][:80])
            rows.append(
                f'<div class="wrow"><a class="wl" href="#t{id(turn)}"><span class="n">{i + 1}</span>{label}</a>'
                f'<div class="wtrack"><div class="wsegs" style="width:{100 * total / longest:.2f}%">{"".join(segs)}</div></div>'
                f'<span class="wd">{fmt_dur(total)}</span></div>'
            )
        legend = "".join(f'<span class="{kind_class(k)}"><i class="sw"></i>{esc(k)}</span>' for k in seen)
        return f'<div class="h2row"><h2>Timeline</h2><div class="legend">{legend}</div></div><div class="wf">{"".join(rows)}</div>'

    def session(self, sess, top=False):
        anchors = {id(s): self.anchor() for s in sess.walk()}
        tot, by = sess.totals()
        out = []
        if top:
            out.append(self.stats(sess, tot))
        else:
            bits = [f"{fmt_dur(tot['wall'])} total", f"model {fmt_dur(tot['llm'])} in {int(tot['calls'])} calls", f"tools {fmt_dur(tot['tools'])} in {int(tot['tool_calls'])} calls"]
            if tot["errors"]:
                bits.append(f'<b class="errc">{int(tot["errors"])} failed</b>')
            if tot["input"] or tot["output"]:
                bits.append(f"{fmt_n(tot['input'])} in · {fmt_n(tot['output'])} out")
            out.append(f'<div class="substat">{" · ".join(bits)}</div>')
        out.append(self.breakdown(tot, by))
        out.append(self.waterfall(sess, anchors))
        if top:
            out.append('<div class="h2row"><h2>Conversation</h2></div>')
        models = [s["model"] for s in sess.walk() if s["kind"] == "llm"]
        main_model = max(set(models), key=models.count) if models else sess.meta.get("model")
        scale = max((s["dur"] for s in sess.walk()), default=0) or 1
        for i, turn in enumerate(sess.turns):
            out.append(f'<section class="turn" id="t{id(turn)}">')
            if turn["idle"] > 0:
                out.append(f'<div class="idle"><span>{fmt_dur(turn["idle"])} waiting on you</span></div>')
            if turn["prompt"] is not None:
                who = "You" if top else "Task"
                out.append(
                    f'<div class="prompt"><div class="who"><b>{who}</b><span>turn {i + 1}</span><span>{fmt_dur(sum(s["dur"] for s in turn["steps"]))}</span></div>'
                    f'<div class="ptext">{esc(turn["prompt"].strip())}</div></div>'
                )
            out.append('<div class="steps">')
            for s in turn["steps"]:
                out.append(self.step(s, anchors[id(s)], main_model, scale))
            out.append("</div></section>")
        return "\n".join(out)

    def row(self, aid, kind, dur, scale, body):
        if dur is None:
            d, mag = "", ""
        else:
            zero = dur < 0.5
            width = 3 if zero else max(4, round(MAG * (dur / scale) ** 0.5))
            d = f'<div class="dur{" zero" if zero else ""}">{fmt_dur(dur)}</div>'
            mag = f'<i{" class=zero" if zero else ""} style="width:{width}px"></i>'
        return f'<div class="row {kind_class(kind)}"{f" id={aid}" if aid else ""}>{d or "<div></div>"}<div class="mag">{mag}</div><div class="body">{body}</div></div>'

    def step(self, s, aid, session_model, scale):
        if s["kind"] == "llm":
            u = s["usage"]
            bits = []
            if s["model"] and s["model"] != session_model:
                bits.append(esc(s["model"]))
            if any(u.values()):
                bits.append(f'{fmt_n(u.get("input", 0))} in · {fmt_n(u.get("output", 0))} out' + (f' · {fmt_n(u["cache_read"])} cached' if u.get("cache_read") else ""))
            main = ""
            if s["text"].strip():
                main += f'<div class="say">{inline(s["text"].strip())}</div>'
            if s["reasoning"]:
                main += f'<details class="reason"><summary>reasoning · {fmt_size(s["reasoning"])}</summary><div class="rtext">{esc(s["reasoning"])}</div></details>'
            body = f'<div class="line"><span class="nm">model</span><div class="main">{main}</div><span class="meta">{" · ".join(bits)}</span><span></span></div>'
            return self.row(aid, "model", s["dur"], scale, body)
        if s["kind"] == "compaction":
            body = (f'<details class="call"><summary class="line"><span class="nm">compaction</span><span class="main"><span class="note">context summarised</span></span>'
                    f'<span class="meta">kept {s["kept"]} messages</span><span class="chev"></span></summary>'
                    f'<div class="callbody">{self.section("summary", "<pre>" + esc(s["summary"]) + "</pre>")}</div></details>')
            return self.row(aid, "compaction", s["dur"], scale, body)
        if s["kind"] == "drop":
            return self.row(None, "other", None, scale, '<div class="line"><span class="nm"></span><span class="main note">last message dropped</span><span></span><span></span></div>')
        n = len(s["calls"])
        par = f'<div class="partag">{n} calls in parallel</div>' if n > 1 else ""
        body = f'<div class="group{" par" if n > 1 else ""}">{par}{"".join(self.call(c) for c in s["calls"])}</div>'
        return self.row(aid, step_kind(s), s["dur"], scale, body)

    def call(self, c):
        name, inp = c["name"], c["input"] if isinstance(c["input"], dict) else {}
        err = c.get("error")
        res = c.get("result") or ""
        sub = c.get("sub")
        label = tool_label(name, inp)
        if name == "read" and (inp.get("offset") or inp.get("limit")):
            label += f' :{inp.get("offset") or 1}' + (f'+{inp["limit"]}' if inp.get("limit") else "")
        first = label.splitlines()[0][:400] if label else ""
        meta = fmt_size(res) if res else "no output"
        if c.get("images"):
            meta += f' · {c["images"]} image(s)'
        main = f'<code class="lbl">{esc(first)}</code>'
        if name == "bash":
            main = f'<code class="lbl"><span class="ps">$</span>{esc(first)}</code>'
        elif name == "edit":
            add, rem = diff_counts(inp.get("old_string", ""), inp.get("new_string", ""))
            meta = f'<span class="add">+{add}</span> <span class="del">−{rem}</span>'
        elif name == "write":
            meta = fmt_size(inp.get("content", "")) + " written"
        elif name == "subagent":
            task = (inp.get("prompt") or "").strip().split("\n")[0][:300]
            main = f'<span class="lbl task">{esc(task)}</span>'
            bits = [esc(first)] if first else []
            if sub:
                stot, _ = sub.totals()
                calls, errs = deep_counts(sub)
                bits.append(f"{int(stot['calls'])} model · {calls} tool calls")
                if errs:
                    bits.append(f'<b class="errc">{errs} failed</b>')
            meta = " · ".join(bits)
        if err:
            lines = [l.strip() for l in res.splitlines() if l.strip()]
            preview = next((l for l in reversed(lines) if not l.startswith("[exit code")), lines[-1] if lines else "")
            main += f'<span class="prev">{esc(preview[:300])}</span>' if preview else ""
            meta = '<b class="errc">failed</b> · ' + meta
        head = (f'<summary class="line"><span class="nm">{esc(name)}</span><span class="main">{main}</span>'
                f'<span class="meta">{meta}</span><span class="chev"></span></summary>')
        body = []
        if name == "bash":
            body.append(self.section("command", f'<pre class="cmd">{esc(inp.get("command", ""))}</pre>'))
        elif name == "edit":
            body.append(self.section("change" + (" (all occurrences)" if inp.get("replace_all") else ""), self.diff(inp.get("old_string", ""), inp.get("new_string", ""))))
        elif name == "write":
            body.append(self.section("content", f'<pre>{esc(clip(inp.get("content", "")))}</pre>'))
        elif name == "subagent" and not sub:
            body.append(self.section("task", f'<pre class="prose">{esc(inp.get("prompt", ""))}</pre>'))
        elif name != "subagent":
            rest = {k: v for k, v in inp.items() if not (isinstance(v, str) and v == label)}
            if rest:
                body.append(self.section("arguments", f'<pre>{esc(json.dumps(rest, indent=2, ensure_ascii=False))}</pre>'))
        out_title = "answer" if name == "subagent" else "error" if err else "output"
        res_cls = "res prose" if name == "subagent" else "res"
        body.append(self.section(out_title, f'<pre class="{res_cls}">{esc(clip(res))}</pre>' if res else '<div class="empty">empty</div>', copy=bool(res)))
        if sub:
            body.append(f'<div class="sub"><div class="subhead">Subagent session <code>{esc(os.path.basename(sub.path)[:-6])}</code></div>{self.session(sub)}</div>')
        elif name == "subagent":
            body.append('<div class="empty">subagent session not found</div>')
        return f'<details class="call{" err" if err else ""}">{head}<div class="callbody">{"".join(body)}</div></details>'

    def section(self, title, content, copy=True):
        btn = '<button class="copy" onclick="copyNext(this)">copy</button>' if copy else ""
        return f'<div class="sec"><div class="sech"><span>{esc(title)}</span>{btn}</div>{content}</div>'

    def diff(self, old, new):
        a, b = old.split("\n") if old else [], new.split("\n") if new else []
        out = []
        for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, a, b, autojunk=False).get_opcodes():
            if tag == "equal":
                same = a[i1:i2]
                if len(same) > 6:
                    same = same[:3] + [None] + same[-3:]
                out += ['<span class="gap">⋯</span>' if l is None else f'<span class="cl">  {esc(l)}</span>' for l in same]
                continue
            out += [f'<span class="dl">− {esc(l)}</span>' for l in a[i1:i2]]
            out += [f'<span class="al">+ {esc(l)}</span>' for l in b[j1:j2]]
        return f'<pre class="diff">{"".join(out)}</pre>'


def diff_counts(old, new):
    a, b = old.split("\n") if old else [], new.split("\n") if new else []
    add = rem = 0
    for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, a, b, autojunk=False).get_opcodes():
        if tag != "equal":
            rem += i2 - i1
            add += j2 - j1
    return add, rem


JS = """
let failAt=-1;
function reveal(t){for(let p=t.parentElement;p;p=p.parentElement){if(p.tagName==='DETAILS')p.open=true}
const d=t.matches('details.call')?t:t.matches('.row')?t.querySelector('details.call'):null;if(d)d.open=true;
t.scrollIntoView({block:'start'});t.classList.add('flash');setTimeout(()=>t.classList.remove('flash'),1400)}
function nextFail(b){const f=[...document.querySelectorAll('details.call.err')];if(!f.length)return;failAt=(failAt+1)%f.length;b.textContent='failed '+(failAt+1)+' of '+f.length;reveal(f[failAt])}
function copyNext(b){const el=b.closest('.sec').querySelector('pre');navigator.clipboard.writeText(el.innerText);b.textContent='copied';setTimeout(()=>b.textContent='copy',1200)}
function toggleAll(open){document.querySelectorAll('details').forEach(d=>d.open=open)}
document.addEventListener('click',e=>{const a=e.target.closest('a[href^="#"]');if(!a)return;const t=document.getElementById(a.getAttribute('href').slice(1));if(!t)return;e.preventDefault();reveal(t)})
"""

