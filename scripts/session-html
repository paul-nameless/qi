def main():
    ap = argparse.ArgumentParser(description="Render a qi session as HTML")
    ap.add_argument("session", nargs="?", help="session id (prefix) or .jsonl path; default: newest in this directory")
    ap.add_argument("-o", "--out")
    ap.add_argument("--no-open", action="store_true")
    a = ap.parse_args()
    path = resolve(a.session)
    sess = Session(path, load(path))
    sid = os.path.basename(path)[:-6]
    body = Renderer().session(sess, top=True)
    page = f'<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>qi {sid[:8]}</title><style>{CSS}</style></head><body>{body}<script>{JS}</script></body></html>'
    out = a.out or os.path.expanduser(f"~/Downloads/qi-session-{sid[:8]}.html")
    with open(out, "w") as f:
        f.write(page)
    print(out)
    if not a.no_open:
        subprocess.run(["open" if sys.platform == "darwin" else "xdg-open", out], check=False)


if __name__ == "__main__":
    main()
